{
  "name": "cold-outreach",
  "version": "1.0.0",
  "description": "Personalized cold email outreach CLI for job-hunt — reads Excel, sends throttled via Gmail SMTP, resumable.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "cold-outreach": "src/index.js"
  },
  "scripts": {
    "send": "node src/index.js send",
    "preview": "node src/index.js preview",
    "stats": "node src/index.js stats",
    "test": "node --test \"tests/**/*.test.js\"",
    "mail:stats": "node src/index.js stats --json data/email_json",
    "mail:preview": "node src/index.js preview --json data/email_json",
    "mail:send": "node src/index.js send --json data/email_json --template T1_NAMED_PERSON",
    "mail:proof": "node src/index.js send --json data/email_json --template T1_NAMED_PERSON --proof-only"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "nodemailer": "^6.9.14",
    "xlsx": "^0.18.5"
  }
}
